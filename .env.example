# Application
NODE_ENV=development
PORT=3000

# MongoDB — use mongodb://mongodb:27017/civil_lab_ims inside Docker
MONGO_URI=mongodb://localhost:27017/civil_lab_ims

# JWT — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_at_least_64_chars_long
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_different_from_access
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookie signing — generate with: openssl rand -base64 32
COOKIE_SECRET=CHANGE_ME_cookie_secret

# First-run admin seed (used only if no User document exists)
ADMIN_EMAIL=admin@lab.edu
ADMIN_PASSWORD=CHANGE_ME_strong_password

# File uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_DIR=./uploads

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:5173
